# Python
__pycache__/
*.py[cod]

# Sauvegardes manuelles faites avant grosse modif
*.bak-*
*.bak

# Fabrication de l'installateur Windows : ~90 Mo d'artefacts, régénérables avec
# packaging\windows\build.ps1. Les binaires publiés vont dans une release GitHub,
# pas dans l'historique du dépôt.
build/
dist/
*.spec

# Sorties des scripts de diagnostic : propres a une machine, pas a versionner.
scripts/*_result.txt

# Prototype Flatpak jetable (jamais a soumettre : le manifeste Flathub est ecrit par Younes)
io.github.*.yml
.pytest_cache/
.ruff_cache/
